# Образ бота вместе с мини-приложением.
#
# Собрать и запустить локально (ровно то же самое произойдёт на сервере):
#   docker build -t family-budget-bot .
#   docker run --rm --env-file .env -v "$PWD/data:/data" -p 8080:8080 family-budget-bot
#
# Секретов внутри образа нет и быть не должно: .env исключён через .dockerignore,
# а значения приходят переменными окружения при запуске (на Amvera — из раздела
# «Переменные и секреты», локально — из --env-file).

FROM python:3.14-slim

# PYTHONUNBUFFERED — чтобы логи появлялись в журнале сразу, а не после закрытия
# буфера: без него первые минуты работы бота выглядят как тишина.
# PYTHONDONTWRITEBYTECODE — .pyc в контейнере не нужны, он одноразовый.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Не /app: на Amvera по этому пути монтируется служебная папка сборки, и она
# перезаписывается при каждом деплое. Кладём код туда, где его никто не тронет.
WORKDIR /opt/app

# Зависимости отдельным слоем и раньше кода: пока requirements.txt не менялся,
# при пересборке Docker берёт готовый слой и не качает пакеты заново.
COPY requirements.txt ./
RUN pip install -r requirements.txt

COPY . .

# --- значения по умолчанию для жизни в контейнере ---------------------------
#
# Их не нужно задавать руками в панели хостинга — там только настоящие секреты.
#
# WEBAPP_HOST=0.0.0.0 — внутри контейнера слушаем все интерфейсы. На своём VPS
#   правильно наоборот (127.0.0.1, а наружу смотрит Caddy), но здесь граница
#   изоляции — сам контейнер, и на 127.0.0.1 платформа до нас не достучится.
# DB_PATH — /data это постоянное хранилище, единственное, что переживает
#   пересборку. Путь абсолютный: относительный отсчитался бы от /opt/app,
#   и база пропадала бы при каждом деплое.
# WEBAPP_TRUSTED_PROXY=* — TLS завершается на nginx платформы, до контейнера
#   доходит обычный HTTP, а настоящий адрес клиента приходит в X-Forwarded-For.
#   Адрес прокси заранее неизвестен, поэтому доверяем заголовку внутри сети.

ENV WEBAPP_HOST=0.0.0.0
ENV WEBAPP_PORT=8080
ENV DB_PATH=/data/bot.sqlite3
ENV WEBAPP_TRUSTED_PROXY="*"
ENV LOG_LEVEL=INFO

EXPOSE 8080

# Пользователя не понижаем намеренно: постоянный том /data платформа монтирует
# от root, и приложение под другим пользователем не смогло бы писать в базу.
# Контейнер здесь и есть граница изоляции. На своём VPS используйте
# deploy/family-budget-bot.service — там бот работает под отдельным пользователем.

CMD ["python", "bot.py"]
